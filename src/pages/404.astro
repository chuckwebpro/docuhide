---
import DocuHideLayout from '../layouts/DocuHideLayout.astro';
import { navigation } from '../config/navigation';
import { site } from '../config/site';
---

<DocuHideLayout
  title="Page not found"
  description="The page you requested is not available on Docuhide. Return to the home page or browse Overview and News."
  noindex
  interior
  styles="interior"
>
  <main class="interior">
    <section class="padding-block-120 container text-center">
      <p class="fs-400 fw-medium margin-block-end-16">Error 404</p>
      <h1 class="fs-700 fw-bold margin-block-end-24">We couldn&rsquo;t find that page</h1>
      <p class="fs-500 max-width-60ch margin-inline-auto margin-block-end-32">
        The link may be out of date, or the page may have moved. Try one of these instead.
      </p>

      <ul class="margin-block-end-32 flex flex-wrap justify-center gap-24">
        {
          navigation.primary.map((item) => (
            <li>
              <a href={item.href ?? '/'} class="fs-500">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-wrap justify-center gap-16">
        <a href="/" class="btn" data-type="pill-btn" data-color="accent1">Back to home</a>
        <a href={`tel:${site.business.phoneHref}`} class="fs-500">
          Call {site.business.phone}
        </a>
      </div>
    </section>
  </main>
</DocuHideLayout>
