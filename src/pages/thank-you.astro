---
import DocuHideLayout from '../layouts/DocuHideLayout.astro';

const params = Astro.url.searchParams;
const thankYouMessage = params.get('thankYouMessage') ?? 'We have received your request.';
const contactName = params.get('contactName') ?? '';
---

<DocuHideLayout
  title="Thank You"
  titleExact
  description="Thank you for contacting Docuhide."
  noindex
  interior
  styles="interior"
>
  <main class="interior">
    <section class="padding-block-120 container text-center">
      <h1 class="fs-700 fw-bold margin-block-end-24">
        Thank You{contactName ? `, ${contactName}` : ''}
      </h1>
      <p class="fs-500">{thankYouMessage}</p>
      <p class="margin-block-start-32">
        <a href="/" class="btn" data-type="pill-btn" data-color="accent1">Return Home</a>
      </p>
    </section>
  </main>
</DocuHideLayout>
