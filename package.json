{
  "name": "docuhide",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "postbuild": "node scripts/finalize-sitemap.mjs && node scripts/sync-site-origin.mjs",
    "preview": "astro preview",
    "preverify": "node scripts/build-tokens.mjs",
    "verify": "astro check && prettier --check .",
    "format": "prettier --write .",
    "audit:lh": "lhci autorun",
    "audit:a11y": "node scripts/run-pa11y-ci.mjs",
    "audit": "npm run audit:lh && npm run audit:a11y",
    "php:check": "node scripts/php-check.mjs",
    "php:install": "node scripts/php-install.mjs",
    "php:serve": "node scripts/php-serve.mjs",
    "php:dev": "npm run build && npm run php:install && npm run php:serve",
    "migrate:images": "node scripts/migrate-docuhide-images.mjs",
    "migrate:css": "node scripts/migrate-docuhide-css.mjs",
    "migrate:articles": "node scripts/migrate-docuhide-articles.mjs",
    "migrate:docuhide": "npm run migrate:images && npm run migrate:css && npm run migrate:articles"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-text": "^5.3.0",
    "@fontsource/montserrat": "^5.2.6",
    "@iconify-json/lucide": "^1.2.136",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.34.4",
    "start-server-and-test": "^2.1.5",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3"
  }
}
